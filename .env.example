# Copy to .env for local development. .env is gitignored.

POSTGRES_USER=jobradar
POSTGRES_PASSWORD=jobradar
POSTGRES_DB=jobradar
POSTGRES_PORT=5432

# SQLAlchemy 2 + psycopg 3 driver URL.
JOB_RADAR_DATABASE_URL=postgresql+psycopg://jobradar:jobradar@localhost:5432/jobradar

# Path to the version-controlled board configuration (ADR-0012).
JOB_RADAR_BOARDS_CONFIG_PATH=config/boards.yml

# Bounded HTTP timeout in seconds (ADR-0009). Unused until the collector exists.
JOB_RADAR_HTTP_TIMEOUT_SECONDS=10.0
